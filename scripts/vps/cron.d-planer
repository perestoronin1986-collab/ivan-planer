# Планер — push-уведомления каждые 5 минут (раньше: cron-job.org + GitHub Actions + vercel.json).
# Дубли безопасны: эндпоинт помечает notification.sent_at.
# Сервер в UTC: бэкап 22:45 UTC = 01:45 МСК. Секрет берём sed'ом, а не source: cron
# исполняет в dash, а значения dotenv с пробелами/кавычками он не разберёт.
*/5 * * * *  planer  { CRON_SECRET=$(sed -n 's/^CRON_SECRET=//p' /opt/planer/shared/.env.production); curl -sS -m 70 -X POST -H "Authorization: Bearer $CRON_SECRET" http://127.0.0.1:3002/api/cron/push; echo; } >> /opt/planer/home/cron.log 2>&1
45 22 * * *  root    /opt/planer/backup-db.sh >> /var/log/planer-backup.log 2>&1
